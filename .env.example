# Copy to .env (git-ignored) on the server, then fill in the values.
# docker compose reads this file automatically.

# Port the whole app is published on (nginx inside the container listens on 80)
APP_PORT=8080

# Domain or IP people will open the shop on
APP_URL=http://localhost:8080

# Required. Generate with: cd backend && php artisan key:generate --show
APP_KEY=

# Postgres credentials for the bundled database
POSTGRES_DB=trendy
POSTGRES_USER=trendy
POSTGRES_PASSWORD=change-me

# Bootstrap superadmin. Created automatically on first start, then left untouched.
# Pick a real password (8+ characters) before going live.
SUPERADMIN_NAME=Super Admin
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=password123
# Optional, digits only
SUPERADMIN_PHONE=

# Set to true once the app is served over HTTPS, so session cookies are secure-only
SESSION_SECURE_COOKIE=false

# Only needed if the API is called cross-origin; same-origin deploys can leave this.
SANCTUM_STATEFUL_DOMAINS=localhost:8080
